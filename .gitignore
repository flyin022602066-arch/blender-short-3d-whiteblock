# Only source, tests, schemas and project documentation belong in this backup.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/DIAGNOSIS_REPORT.md
!/IMPROVEMENT_SUMMARY.md
!/TEST_EXECUTION_LOG.md
!/launch_whiteblock.bat
!/diagnose_coordinate_system.py
!/test_camera_upgrade.py
!/test_perspective_render.py
!/whiteblock/
!/tests/
!/schemas/
!/blender/
!/docs/
!/checklists/

# Python environments, build products and caches.
**/__pycache__/
*.py[cod]
.venv*/
venv/
.pytest_cache/
**/.pytest_cache/
**/node_modules/
**/dist/
**/build/
*.egg-info/

# User projects, source media, model assets and generated results stay local.
/output/
/library/
/_smoke/
*.blend
*.blend[0-9]*
*.mp4
*.mov
*.mkv
*.avi
*.wav
*.mp3
*.onnx
*.pt
*.pth
*.safetensors
*.task

# Credentials, local configuration and database exports must never be staged.
.env
.env.*
**/.env
**/.env.*
config.json
config.local.*
settings.local.*
*secrets*
*credentials*
*api_key*
*apikey*
*.pem
*.key
*.p12
*.pfx
*.keystore
*.sqlite*
*.db
*.log
*.bak
*.backup
*.part
*~
